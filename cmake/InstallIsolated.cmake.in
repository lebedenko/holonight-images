set(bundle "@HOLONIGHT_IMAGES_RUNTIME_BUNDLE@")
if(NOT IS_DIRECTORY "${bundle}")
  message(FATAL_ERROR "Prepare a host-native runtime and set HOLONIGHT_IMAGES_RUNTIME_BUNDLE before installing Isolated")
endif()
file(READ "${bundle}/manifest.json" manifest)
string(JSON version GET "${manifest}" version)
if(NOT version EQUAL 1)
  message(FATAL_ERROR "Unsupported isolated runtime manifest")
endif()
file(SHA256 "@CMAKE_CURRENT_BINARY_DIR@/holonight-images-helper" helper_hash)
file(SHA256 "${bundle}/usr/libexec/holonight-images-helper" bundle_helper_hash)
if(NOT helper_hash STREQUAL bundle_helper_hash)
  message(FATAL_ERROR "Prepared runtime is stale: rebuild the bundle explicitly")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/holonight-images-helper" --verify-runtime "${bundle}"
  RESULT_VARIABLE verified)
if(NOT verified EQUAL 0)
  message(FATAL_ERROR "Runtime inventory, modes, sizes or hashes failed verification")
endif()

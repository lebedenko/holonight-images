option(HOLONIGHT_IMAGES_ISOLATED "Build the opt-in Linux isolated raster client and helper" OFF)
option(HOLONIGHT_IMAGES_RUNTIME_TESTING "Run installed namespace/systemd integration tests on a capable host" OFF)
set(HOLONIGHT_IMAGES_RUNTIME_BUNDLE "" CACHE PATH "Explicitly prepared host-native isolated runtime to install")
if(HOLONIGHT_IMAGES_ISOLATED)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "The isolated raster runtime requires Linux")
  endif()
  add_library(holonight_images_isolated STATIC src/isolated/client.cpp src/isolated/capture.cpp src/isolated/protocol.cpp src/isolated/runtime.cpp src/isolated/cleanup.cpp src/isolated/verification.cpp)
  add_library(HolonightImages::Isolated ALIAS holonight_images_isolated)
  set_target_properties(holonight_images_isolated PROPERTIES EXPORT_NAME Isolated POSITION_INDEPENDENT_CODE ON)
  target_link_libraries(holonight_images_isolated PUBLIC HolonightImages::Images)
  target_compile_options(holonight_images_isolated PRIVATE -Wall -Wextra -Wpedantic)
  add_executable(holonight-images-helper src/isolated/helper.cpp src/isolated/protocol.cpp src/isolated/verification.cpp)
  target_link_libraries(holonight-images-helper PRIVATE HolonightImages::Images)
  install(TARGETS holonight_images_isolated EXPORT HolonightImagesTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  # Preparation is explicit and separate from launch/install discovery. Installation
  # is deliberately refused until a prepared bundle matching this helper is supplied.
  configure_file(${CMAKE_CURRENT_LIST_DIR}/InstallIsolated.cmake.in ${CMAKE_CURRENT_BINARY_DIR}/InstallIsolated.cmake @ONLY)
  install(SCRIPT ${CMAKE_CURRENT_BINARY_DIR}/InstallIsolated.cmake)
  if(HOLONIGHT_IMAGES_RUNTIME_BUNDLE)
    install(DIRECTORY "${HOLONIGHT_IMAGES_RUNTIME_BUNDLE}/" DESTINATION ${CMAKE_INSTALL_LIBEXECDIR}/holonight-images/runtime USE_SOURCE_PERMISSIONS)
  endif()
endif()

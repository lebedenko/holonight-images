function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Isolated installed consumer failed: ${ARGV}")
  endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${PROVIDER_BUILD}" --prefix "${TEST_ROOT}/prefix")
# Copy to a new prefix to ensure launch does not depend on the original install path.
file(COPY "${TEST_ROOT}/prefix/" DESTINATION "${TEST_ROOT}/relocated prefix")
run("${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${TEST_ROOT}/build" "-DCMAKE_PREFIX_PATH=${TEST_ROOT}/relocated prefix" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
run("${CMAKE_COMMAND}" --build "${TEST_ROOT}/build")
if(RUN_RUNTIME)
run("${TEST_ROOT}/build/isolated-consumer" "${TEST_ROOT}/relocated prefix/libexec/holonight-images/runtime" "${FIXTURES}")
endif()
